# Copy to backend/.env and adjust as needed. All values are optional.

# Path to the MediaPipe Face Landmarker model bundle (download with scripts/download_model.py)
FACE_LANDMARKER_MODEL_PATH=models/face_landmarker.task

# Comma-separated list of origins allowed to call the API (the Next.js dev server)
CORS_ORIGINS=http://localhost:3000

# Max upload size in megabytes
MAX_UPLOAD_MB=10

# MediaPipe thresholds (0.0 - 1.0)
MIN_FACE_DETECTION_CONFIDENCE=0.5
MIN_FACE_PRESENCE_CONFIDENCE=0.5

# A second face counts as "significant" (rejects the photo) when its bbox area is at least
# this fraction of the largest face's area. Smaller faces are ignored with a warning.
SECONDARY_FACE_AREA_RATIO=0.20

# Reject images with more decoded pixels than this (checked before decoding). 25 MP.
MAX_IMAGE_PIXELS=25000000

# --- Face parsing / segmentation (download with scripts/download_face_parser.py) ---
# LICENSE: the default weights were trained on CelebAMask-HQ (non-commercial research data).
FACE_PARSER_MODEL_PATH=models/face_parser_resnet18.onnx
# SHA-256 the weights file must match, or the parser is disabled (/segmentation returns 503)
FACE_PARSER_SHA256=0d9bd318e46987c3bdbfacae9e2c0f461cae1c6ac6ea6d43bbe541a91727e33f
# Square parse window = landmark bbox side x this factor (1.0 - 4.0)
FACE_PARSER_CROP_SCALE=2.0
# Simultaneous inferences, and how long a request waits for a slot before getting 503
FACE_PARSER_MAX_CONCURRENCY=2
FACE_PARSER_QUEUE_TIMEOUT_S=5
# onnxruntime intra-op threads (0 = library default)
FACE_PARSER_THREADS=0
